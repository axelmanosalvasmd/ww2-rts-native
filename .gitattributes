# Generated Rust JSON must retain canonical bytes on Windows checkouts.
rust/**/*.json text eol=lf

# Canonical startup-table JSON must retain exact LF bytes on every platform.
docs/contracts/startup-tables/**/*.json text eol=lf

# Unreal binary assets go through Git LFS.
unreal/**/*.uasset filter=lfs diff=lfs merge=lfs -text
unreal/**/*.umap filter=lfs diff=lfs merge=lfs -text
unreal/**/*.fbx filter=lfs diff=lfs merge=lfs -text
unreal/**/*.glb filter=lfs diff=lfs merge=lfs -text
unreal/**/*.png filter=lfs diff=lfs merge=lfs -text
unreal/**/*.jpg filter=lfs diff=lfs merge=lfs -text
unreal/**/*.tga filter=lfs diff=lfs merge=lfs -text
unreal/**/*.exr filter=lfs diff=lfs merge=lfs -text
unreal/**/*.wav filter=lfs diff=lfs merge=lfs -text
unreal/**/*.ogg filter=lfs diff=lfs merge=lfs -text
